# Obtén estos valores en https://my.telegram.org/apps
# Copia este archivo a /volume1/docker/telegram-downloader/config.env en el NAS.
# Nunca pongas API_ID / API_HASH / sesión en docker-compose.yml.

API_ID=12345678
API_HASH=tu_api_hash_aqui

# ID del grupo privado (usa list_chats.py para encontrarlo)
CHAT_ID=-1001234567890

# En el despliegue NAS (docker-compose.yml) estas rutas las fija Compose.
# No hace falta definirlas aquí; si las pones, Compose las sobrescribe:
#   DOWNLOAD_DIR=/data/media/Downloads
#   SESSION_NAME=/app/data/telegram_session
#   STATE_FILE=/app/data/downloaded.json
#   PROGRESS_FILE=/app/data/downloader.progress
#   MANUAL_QUEUE_FILE=/app/data/manual_download_queue.json
#   LOG_PATH=/app/data/downloader.log
#   DATA_DIR=/app/data
#
# Layout bajo el único mount /data/media (= /volume1/Media):
#   DOWNLOAD_DIR/Inbox
#   /data/media/Movies          (hermano de Downloads)
#   /data/media/Series
#   /data/media/Documentaries
#   /data/media/Home Videos

# Panel de estado/logs
# Compose fuerza DASHBOARD_HOST=0.0.0.0 en el contenedor.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765

# Notificaciones de macOS (en Docker/Linux se ignoran / Compose pone NOTIFY=false)
NOTIFY=false
NOTIFY_APP_NAME=Telegram Downloader

# Backend de control del servicio:
# - process  → proceso Python (por defecto en Linux/Docker; Compose lo fija)
# - launchd  → macOS LaunchAgent (solo uso local en Mac)
# SERVICE_BACKEND=process
