# Obtén estos valores en https://my.telegram.org/apps
API_ID=12345678
API_HASH=tu_api_hash_aqui

# ID del grupo privado (usa list_chats.py para encontrarlo)
CHAT_ID=-1001234567890

# Carpeta donde se guardarán los videos (organizados por año-mes)
DOWNLOAD_DIR=/Users/kevin/Videos/Telegram

# Panel local de estado/logs (solo accesible desde tu Mac)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Notificaciones de macOS al detectar y completar descargas
NOTIFY=true
NOTIFY_APP_NAME=Telegram Downloader
