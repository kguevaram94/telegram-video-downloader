# Obtén estos valores en https://my.telegram.org/apps
API_ID=12345678
API_HASH=tu_api_hash_aqui

# ID del grupo privado (usa list_chats.py para encontrarlo)
CHAT_ID=-1001234567890

# Carpeta donde se guardarán los videos (organizados por año-mes)
# En macOS local:
DOWNLOAD_DIR=/Users/kevin/Videos/Telegram
# En Docker/NAS estas rutas las fija docker-compose.yml:
# DOWNLOAD_DIR=/data/videos
# SESSION_NAME=/app/data/telegram_session
# STATE_FILE=/app/data/downloaded.json
# LOG_PATH=/app/data/downloader.log

# Panel de estado/logs
# macOS local: 127.0.0.1 | Docker/NAS: 0.0.0.0 (lo fija compose)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765

# Notificaciones de macOS (en Docker/Linux se ignoran)
NOTIFY=true
NOTIFY_APP_NAME=Telegram Downloader

# Backend de control del servicio:
# - launchd  → macOS LaunchAgent (por defecto en Darwin)
# - process  → proceso Python (por defecto en Linux/Docker)
# SERVICE_BACKEND=process
